# ================================================================
# API Hunter AI - قالب متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم (الجذر يعمل لجميع الحزم)
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Linux/Mac)
# تحقق بعد التعبئة بالأمر:  npm run env:check
# ================================================================

# ---------- قاعدة البيانات (Supabase PostgreSQL أو محلية) ----------
# محليا بواسطة docker compose:
# DATABASE_URL="postgresql://apihunter:apihunter@localhost:5432/apihunter?schema=public"
# Supabase — يُفضّل Pooler (يعمل عبر IPv4 في Vercel و GitHub Actions):
#   للـ db push / seed / التطوير المحلي (Session Pooler, منفذ 5432):
#   DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public"
#   للتشغيل السحابي في Vercel/GitHub (Transaction Pooler, منفذ 6543):
#   DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=public"
#
# أسهل طريقة للربط (يتولّى .env + Vercel + GitHub + الزرع):
#   npm run db:link -- "postgresql://...<نفس الصيغة>..."
DATABASE_URL="postgresql://apihunter:apihunter@localhost:5432/apihunter?schema=public"

# ---------- الذكاء الاصطناعي (اختياري: بدونها يعمل بوضع Heuristic) ----------
# مفتاح OpenAI للتحليل الذكي (أو أي مزود متوافق مثل Groq/DeepSeek)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""
# مفتاح Google Gemini (بديل) - يُستدعى عبر واجهة OpenAI المتوافقة
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# عدد محاولات إعادة الطلب عند 429/5xx (الطبقة المجانية محدودة بالدقيقة)
AI_MAX_ATTEMPTS="3"

# ---------- بوت تليجرام ----------
# أنشئ البوت عبر @BotFather وخذ التوكن
TELEGRAM_BOT_TOKEN=""
# معرف القناة: من @userinfobot (رقم موجب) أو -100xxxxxxxxxx للقنوات الخاصة
TELEGRAM_CHANNEL_ID=""
# معرفات المدراء (مفصولة بفواصل) مثلاً: 1665333044
TELEGRAM_ADMIN_IDS=""
# وضع التشغيل: "false" = Webhook على Vercel (الأفضل والمجاني) | "true" = Polling محلي
BOT_POLLING="false"
# رابط النشر الذي يستقبل تحديثات تليجرام (Vercel)
BOT_WEBHOOK_URL="https://api-hunter-ai.vercel.app"
# سرّ حماية الويب هوك (سلسلة عشوائية 1-256 حرفاً: a-z A-Z 0-9 _ -)
BOT_WEBHOOK_SECRET=""
# سرّ حماية مسار النشر للقناة (يرسله Vercel Cron تلقائياً في هيدر Authorization)
CRON_SECRET=""

# ---------- جدولة المحرك ----------
# كل كم ساعة يُنفذ البحث اليومي
AGENT_SCHEDULE_HOURS="6"
# توازي التحليل (خفّضه إلى 1-2 عند استخدام طبقة مجانية محدودة RPM)
AGENT_CONCURRENCY="2"
# عدد الثواني التي ينتظرها البوت قبل فحص جديد على القناة
BOT_CHANNEL_POLL_SECONDS="300"

# ---------- صفحة الويب ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL="https://t.me/APIHUNTERAI"
NEXT_PUBLIC_TELEGRAM_BOT_URL="https://t.me/api_hunter_ai_bot"

# ---------- الشبكة (اختياري) ----------
HTTP_PROXY=""
HTTPS_PROXY=""