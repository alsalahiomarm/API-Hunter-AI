# انسخ إلى .env (جذر المشروع أو داخل apps/bot)
TELEGRAM_BOT_TOKEN="123456789:AAF-YourBotTokenFrom_BotFather"
# معرف القناة الرقمية الموجبة (من @userinfobot) أو -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=""
BOT_POLLING="true"
BOT_WEBHOOK_URL=""
BOT_WEBHOOK_SECRET=""

# قاعدة البيانات (اختياري - بدونها يعمل البوت على البيانات التجريبية)
DATABASE_URL="postgresql://apihunter:apihunter@localhost:5432/apihunter?schema=public"

# مدة الفحص الدوري للقناة بالثواني
BOT_CHANNEL_POLL_SECONDS="300"