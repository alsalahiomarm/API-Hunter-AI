# انسخ إلى .env في جذر المشروع أو داخل apps/agent
DATABASE_URL="postgresql://apihunter:apihunter@localhost:5432/apihunter?schema=public"

# ذكاء التحليل (اختياري - يعمل بدونه وضع Heuristic)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# عدد ساعات دورة البحث
AGENT_SCHEDULE_HOURS="6"